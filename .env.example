# Copy to .env and fill in. Never commit .env.
# Relative paths are resolved from the project folder.

# OAuth client downloaded from Google Cloud (Desktop app type)
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json
# Written by: uv run python -m src.common.youtube_auth
YOUTUBE_TOKEN_FILE=secrets/token.json

# Discord: Server Settings > Integrations > Webhooks > Copy Webhook URL
DISCORD_WEBHOOK_URL=
